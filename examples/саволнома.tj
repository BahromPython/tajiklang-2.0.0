# Саволнома — бо функсияи «хонед» маълумот мегирем

ворид матн
ворид риёзӣ

навис("Салом! Ман якчанд савол медиҳам.")

бигзор ном = матн.тоза(хонед("Номи шумо чист? "))
бигзор ҷавоб = матн.тоза(хонед("Синну соли шумо чанд аст? "))

агар не матн.рақам_аст(ҷавоб):
    навис("Ин рақам нест:", ҷавоб)
вагарна:
    бигзор сол = ба_рақам(ҷавоб)

    навис("---")
    навис("Салом,", матн.калон(ном) + "!")
    навис("Соли оянда шумо", сол + 1, "мешавед.")

    агар сол >= 16:
        навис("Шумо метавонед барномасозиро омӯзед.")
    вагарна:
        навис("Барномасозӣ дар ҳар синну сол оғоз мешавад!")

    бигзор рӯзҳо = сол * 365
    навис("Шумо тақрибан", рӯзҳо, "рӯз умр дидед.")
    навис("Решаи синну соли шумо:", риёзӣ.гирд(риёзӣ.реша(сол), 2))
