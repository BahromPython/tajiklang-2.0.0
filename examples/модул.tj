# Модулҳо: дарунсохт ва аз файли ҳамсоя

ворид риёзӣ
ворид асбоб

навис("реша(144) =", риёзӣ.реша(144))
навис("2 ба дараҷаи 10 =", риёзӣ.дараҷа(2, 10))
навис("мутлақ(-7) =", риёзӣ.мутлақ(-7))
навис("ПИ ≈", риёзӣ.гирд(риёзӣ.ПИ * 1000) / 1000)

навис("---")

навис("асбоб.дучанд(21) =", асбоб.дучанд(21))
навис("миёна =", асбоб.миёна([2, 4, 6, 8]))
навис("номи модул:", асбоб.НОМИ_МОДУЛ)
