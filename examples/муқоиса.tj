# Муқоиса ва мантиқ

бигзор синну_сол = 16

навис("Синну сол:", синну_сол)
навис("16 ё зиёдтар?", синну_сол >= 16)
навис("Байни 10 ва 20?", синну_сол > 10 ва синну_сол < 20)
навис("Хурд нест?", не (синну_сол < 10))

# Қиматҳои мантиқӣ
навис(рост, дурӯғ, холӣ)

# Навъҳои гуногун ҳеҷ гоҳ баробар нестанд
навис("рост == 1 ->", рост == 1)
навис("рақам == матн ->", 1 == "1")

# Тартиби алифбои тоҷикӣ, на тартиби Unicode
навис("Ғафуров пеш аз Яқубов?", "Ғафуров" < "Яқубов")
навис("г пеш аз ғ?", "г" < "ғ")
