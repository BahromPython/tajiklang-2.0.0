# Санҷиши маълумот — шикан, давом, кӯшиш ва хато

бигзор ададҳо = ["12", "салом", "7", "-3", "0", "99"]

навис("Ҳамаи қиматҳо:")
барои матни_адад аз ададҳо:
    кӯшиш:
        бигзор адад = ба_рақам(матни_адад)
        навис(" ", матни_адад, "->", адад)
    хато паём:
        навис(" ", матни_адад, "-> хато:", паём)

навис(такрор("-", 40))

# шикан: то аввалин қимати нодуруст меҳисобем
бигзор ҷамъ = 0
барои матни_адад аз ададҳо:
    агар не рақам_аст(матни_адад):
        навис("Дар", матни_адад, "истодем.")
        шикан
    ҷамъ += ба_рақам(матни_адад)

навис("Ҷамъ то истодан:", ҷамъ)

навис(такрор("-", 40))

# давом: қиматҳои нодурустро мепартоем
бигзор дурустҳо = []
барои матни_адад аз ададҳо:
    агар не рақам_аст(матни_адад):
        давом
    илова(дурустҳо, ба_рақам(матни_адад))

навис("Дурустҳо:", дурустҳо)
навис("Ҷамъ:", ҷамъи(дурустҳо))
навис("Миёна:", гирд(миёна(дурустҳо), 2))
навис("Аз хурд ба калон:", тартиб(дурустҳо))
навис("Охирин:", дурустҳо[-1])
