# Рӯйхат ва луғат

бигзор номҳо = ["Яқубов", "Ғафуров", "Аҳмадов", "Ҷӯраев"]

навис("Ҳама:", номҳо)
навис("Дарозӣ:", дарозӣ(номҳо))
навис("Якум:", номҳо[0])

# Тартиб бо алифбои тоҷикӣ, на бо рамзҳои Unicode
навис("Тартиб:", тартиб(номҳо))

илова(номҳо, "Каримов")
номҳо[0] = "Яқубова"
навис("Пас аз тағйир:", номҳо)

барои ном аз номҳо:
    навис("-", ном)

навис("---")

# Луғат
бигзор донишҷӯ = {"ном": "Баҳром", "синф": 10, "баҳо": 5}

навис(донишҷӯ["ном"], "аз синфи", донишҷӯ["синф"])
донишҷӯ["шаҳр"] = "Душанбе"

навис("Калидҳо:", калидҳо(донишҷӯ))
навис("Шаҳр дорад?", дорад(донишҷӯ, "шаҳр"))

барои калид аз донишҷӯ:
    навис(калид, "->", донишҷӯ[калид])

# Навъи ҳар қимат
навис(навъ(1), навъ("а"), навъ(рост), навъ([1]), навъ({}), навъ(холӣ))
