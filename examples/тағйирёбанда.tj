# Тағйирёбандаҳо ва арифметика

бигзор ном = "Баҳром"
бигзор синну_сол = 16

навис("Салом,", ном)
навис("Синну сол:", синну_сол)

# Арифметика
бигзор паҳно = 4
бигзор дарозӣ = 7.5
навис("Масоҳат:", паҳно * дарозӣ)

# Тартиби амалҳо: * пеш аз +
навис(2 + 3 * 4)
навис((2 + 3) * 4)

# Тағйир додани қимат бе "бигзор"
синну_сол = синну_сол + 1
навис("Соли оянда:", синну_сол)
