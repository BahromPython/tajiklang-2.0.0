# Функсияҳо

функсия ҷамъ(a, b):
    баргардон a + b

навис("ҷамъ(5, 7) =", ҷамъ(5, 7))

# Функсия бе баргардон қимати «холӣ» медиҳад
функсия салом(ном):
    навис("Салом,", ном)

салом("Баҳром")

# Рекурсия — ҳолати хотима ҳатмист
функсия факториал(n):
    агар n <= 1:
        баргардон 1
    баргардон n * факториал(n - 1)

барои i аз 1 то 6:
    навис(i, "! =", факториал(i))

# Функсияҳо худашон қимат ҳастанд
функсия дучанд(x):
    баргардон x * 2

бигзор амал = дучанд
навис("амал(21) =", амал(21))

# Функсия номҳои атрофи худро мебинад (closure)
бигзор зарб = 3
функсия сегона(x):
    баргардон x * зарб

навис("сегона(7) =", сегона(7))
