# чаро, |> ва хатоҳои навъдор

# --- чаро: "чаро тағйирёбандаи ман ҳамин аст?" ---------------------------
бигзор ҷамъ = 0
барои i аз 1 то 5:
    ҷамъ += i

навис("Ҷамъ:", ҷамъ)
навис("")
чаро(ҷамъ)

навис("")
навис(такрор("-", 46))

# --- |> : амалҳо аз чап ба рост, мисли ҷумлаи тоҷикӣ ---------------------
бигзор номҳо = ["Яқубов", "Ғафуров", "Аҳмадов"]

номҳо |> тартиб |> навис
навис([3, 1, 2] |> тартиб |> баръакс)
навис("салом ҷаҳон" |> калон)
навис("а,б,в" |> ҷудо(",") |> дарозӣ)

навис(такрор("-", 46))

# --- хатоҳои навъдор -----------------------------------------------------
функсия бехатар(амал):
    кӯшиш:
        амал()
    хато "тақсим_ба_сифр":
        навис("  ба сифр тақсим кардан мумкин нест")
    хато "берун_аз_ҳудуд":
        навис("  чунин унсур нест")
    хато паём:
        навис("  хатои дигар:", паём)

функсия як():
    навис(10 / 0)

функсия ду():
    навис([1, 2][99])

функсия се():
    навис(не "матн")

навис("Санҷиши хатоҳо:")
бехатар(як)
бехатар(ду)
бехатар(се)
навис("Барнома то охир расид.")
