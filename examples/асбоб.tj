# Модули ёридиҳанда — аз файли дигар ворид карда мешавад

функсия дучанд(x):
    баргардон x * 2

функсия миёна(рӯйхат):
    агар дарозӣ(рӯйхат) == 0:
        баргардон 0
    бигзор ҷамъ = 0
    барои қимат аз рӯйхат:
        ҷамъ = ҷамъ + қимат
    баргардон ҷамъ / дарозӣ(рӯйхат)

бигзор НОМИ_МОДУЛ = "асбоб"
