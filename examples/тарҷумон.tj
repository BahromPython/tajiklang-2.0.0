# тарҷумон.tj — тарҷумони TajikLang → C, навишташуда бо худи TajikLang
#
# Ин намуна ба саволе ҷавоб медиҳад: «Оё забон метавонад тарҷумони худро
# нависад?» Ин ҷо танҳо як фармон — навис("...") — дастгирӣ мешавад, вале
# ҳамин кофист, то нишон диҳем, ки роҳ кушода аст.

ворид файл

бигзор НАВСАТР = "\n"
бигзор НОХУНАК = "\""

функсия матни_дарун(сатр):
    # Аз навис("чизе") матни дохили нохунакҳоро мегирад.
    бигзор аввал = ёфтан(сатр, НОХУНАК)
    агар аввал == холӣ:
        баргардон холӣ

    бигзор боқӣ = буриш(сатр, аввал + 1, дарозӣ(сатр) - 1)
    бигзор охир = ёфтан(боқӣ, НОХУНАК)
    агар охир == холӣ ё охир == 0:
        баргардон холӣ

    баргардон буриш(боқӣ, 0, охир - 1)


функсия тарҷума(матни_барнома):
    # Ҳар сатри навис(...) ба як printf табдил меёбад.
    бигзор сатрҳо = ["#include <stdio.h>", "", "int main(void) {"]

    барои сатр аз ҷудо(матни_барнома, НАВСАТР):
        бигзор тоза_сатр = тоза(сатр)
        агар сар_мешавад(тоза_сатр, "навис("):
            бигзор чиз = матни_дарун(тоза_сатр)
            агар чиз != холӣ:
                илова(сатрҳо, "    printf(" + НОХУНАК + чиз + "\\n" + НОХУНАК + ");")

    илова(сатрҳо, "    return 0;")
    илова(сатрҳо, "}")
    баргардон пайваст(сатрҳо, НАВСАТР) + НАВСАТР


# --- барномае, ки тарҷума мешавад ---
бигзор барнома = пайваст([
    "навис(" + НОХУНАК + "Салом Тоҷикистон!" + НОХУНАК + ")",
    "навис(" + НОХУНАК + "Ин сатрҳо аз C чоп мешаванд." + НОХУНАК + ")",
], НАВСАТР)

навис("--- Барномаи TajikLang ---")
навис(барнома)
навис("")
навис("--- Коди C, ки тарҷумон сохт ---")

бигзор натиҷа = тарҷума(барнома)
навис(натиҷа)

файл.навиштан("баромад.c", натиҷа)
навис("--- дар файли баромад.c нигоҳ дошта шуд ---")
