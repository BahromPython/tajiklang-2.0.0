# Кор бо матн

ворид матн

бигзор ҷумла = "  Донишҷӯёни Тоҷикистон  "

навис("Аслӣ:", ҷумла)
навис("Тоза:", матн.тоза(ҷумла))
навис("Калон:", матн.калон(матн.тоза(ҷумла)))
навис("Дарозӣ:", дарозӣ(матн.тоза(ҷумла)))

бигзор калимаҳо = матн.ҷудо(матн.тоза(ҷумла))
навис("Калимаҳо:", калимаҳо)
навис("Шумораи калимаҳо:", дарозӣ(калимаҳо))

навис("---")

бигзор шаҳрҳо = "Душанбе,Хуҷанд,Кӯлоб,Бохтар"
барои шаҳр аз матн.ҷудо(шаҳрҳо, ","):
    навис("-", шаҳр, "(" + ба_матн(дарозӣ(шаҳр)) + " ҳарф)")

навис("---")

навис(матн.иваз("салом-салом", "салом", "хайр"))
навис(матн.буриш("Тоҷикистон", 0, 3))
навис(матн.такрор("=", 20))
навис(баръакс("Салом"))
