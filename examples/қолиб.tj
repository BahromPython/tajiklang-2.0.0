# Қолибҳо (синфҳо) — маълумот ва амалҳоро якҷоя нигоҳ медоранд
#
# Қолиб мисли қолиби хишт аст: аз як қолиб чандин объект сохта мешавад.

қолиб Одам:
    функсия оғоз(худ, ном, шаҳр):
        худ.ном = ном
        худ.шаҳр = шаҳр

    функсия салом(худ):
        баргардон "Салом, ман " + худ.ном + " аз " + худ.шаҳр

# «мерос» — қолиби нав ҳамаи функсияҳои волидро мегирад
қолиб Донишҷӯ мерос Одам:
    функсия оғоз(худ, ном, шаҳр, баҳоҳо):
        худ.ном = ном
        худ.шаҳр = шаҳр
        худ.баҳоҳо = баҳоҳо

    функсия миёнаи_баҳо(худ):
        агар холӣ_аст(худ.баҳоҳо):
            баргардон 0
        баргардон миёна(худ.баҳоҳо)

    функсия хулоса(худ):
        бигзор м = худ.миёнаи_баҳо()
        агар м >= 4.5:
            баргардон "аъло"
        вагарна агар м >= 3.5:
            баргардон "хуб"
        баргардон "қаноатбахш"

бигзор донишҷӯён = [
    Донишҷӯ("Яқубов", "Душанбе", [5, 4, 5, 5]),
    Донишҷӯ("Ғафуров", "Хуҷанд", [3, 4, 4, 3]),
    Донишҷӯ("Аҳмадов", "Кӯлоб", [5, 5, 5, 4]),
]

функсия номи(д):
    баргардон д.ном

функсия баҳои(д):
    баргардон д.миёнаи_баҳо()

навис("Журнал")
навис(такрор("=", 46))

барои д аз тартиб_бо(донишҷӯён, номи):
    навис(д.ном, "|", гирд(д.миёнаи_баҳо(), 2), "|", д.хулоса())

навис(такрор("=", 46))

бигзор беҳтарин = тартиб_бо(донишҷӯён, баҳои)[-1]
навис("Беҳтарин:", беҳтарин.ном)
навис(беҳтарин.салом())        # функсия аз қолиби волид
навис("Навъи объект:", навъ(беҳтарин))
