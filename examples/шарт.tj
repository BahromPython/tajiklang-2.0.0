# Шартҳо: агар / вагарна агар / вагарна

бигзор синну_сол = 16
бигзор мақом = ""

агар синну_сол >= 18:
    мақом = "калонсол"
вагарна агар синну_сол >= 16:
    мақом = "наврас"
    навис("Шумо метавонед барномасозиро омӯзед")
вагарна:
    мақом = "хурд"

навис("Мақом:", мақом)

# Блокҳои дарунӣ
агар синну_сол > 10 ва синну_сол < 20:
    навис("Синну сол байни 10 ва 20 аст")

    агар синну_сол % 2 == 0:
        навис("Синну сол ҷуфт аст")
    вагарна:
        навис("Синну сол тоқ аст")

навис("Барнома тамом шуд")
