# Журнали баҳоҳо — рӯйхат, луғат, функсия ва давр дар як барнома
# Ҳеҷ "ворид" лозим нест: ҳамаи функсияҳо аз аввал дастрасанд.

бигзор донишҷӯён = [
    {"ном": "Яқубов", "баҳоҳо": [5, 4, 5, 5]},
    {"ном": "Ғафуров", "баҳоҳо": [3, 4, 4, 3]},
    {"ном": "Аҳмадов", "баҳоҳо": [5, 5, 5, 4]},
    {"ном": "Ҷӯраев", "баҳоҳо": [2, 3, 3, 4]},
]

функсия хулоса(миёнаи_баҳо):
    агар миёнаи_баҳо >= 4.5:
        баргардон "аъло"
    вагарна агар миёнаи_баҳо >= 3.5:
        баргардон "хуб"
    вагарна агар миёнаи_баҳо >= 2.5:
        баргардон "қаноатбахш"
    баргардон "суст"

функсия номи_донишҷӯ(д):
    баргардон д["ном"]

функсия баҳои_донишҷӯ(д):
    баргардон миёна(д["баҳоҳо"])

навис("Журнали синфи 10")
навис(такрор("=", 40))

# тартиб_бо номҳоро бо алифбои тоҷикӣ ҷобаҷо мекунад:
# Ғ баъд аз Г меояд, на баъд аз Я
барои д аз тартиб_бо(донишҷӯён, номи_донишҷӯ):
    бигзор натиҷа = миёна(д["баҳоҳо"])
    навис(д["ном"], "|", гирд(натиҷа, 2), "|", хулоса(натиҷа))

навис(такрор("=", 40))

# Беҳтарин донишҷӯ — охирин дар тартиби баҳоҳо
бигзор аз_рӯи_баҳо = тартиб_бо(донишҷӯён, баҳои_донишҷӯ)
бигзор беҳтарин = аз_рӯи_баҳо[-1]
навис("Беҳтарин:", беҳтарин["ном"])

бигзор ҳама_баҳоҳо = []
барои д аз донишҷӯён:
    васеъ(ҳама_баҳоҳо, д["баҳоҳо"])

навис("Миёнаи синф:", гирд(миёна(ҳама_баҳоҳо), 2))
навис("Шумораи баҳоҳо:", дарозӣ(ҳама_баҳоҳо))
навис("Баландтарин баҳо:", калонтарин(ҳама_баҳоҳо))
