# Саҳифаи интернетӣ — бо TajikLang
#
# Дар браузер: саҳифа зинда сохта мешавад ва тугмаҳо кор мекунанд.
# Дар терминал: «саҳифа.ҳамчун_матн» матни HTML медиҳад,
# ки онро бо «файл.навиштан» нигоҳ доштан мумкин аст.

ворид саҳифа

бигзор донишҷӯён = [
    {"ном": "Аҳмадов", "баҳо": 4.75},
    {"ном": "Ғафуров", "баҳо": 3.5},
    {"ном": "Ҷӯраев", "баҳо": 3},
    {"ном": "Яқубов", "баҳо": 4.75},
]

функсия номи(д):
    баргардон д["ном"]

функсия баҳои(д):
    баргардон д["баҳо"]

функсия беҳтаринро_нишон_деҳ():
    бигзор тартибдода = тартиб_бо(донишҷӯён, баҳои)
    бигзор беҳтарин = тартибдода[-1]
    саҳифа.нависед(
        саҳифа.услуб(
            саҳифа.матн("Беҳтарин:", беҳтарин["ном"], "—", беҳтарин["баҳо"]),
            {"ранг": "#0f7b5f", "ғафсӣ": "bold"},
        ),
    )

функсия ҳисобро_нишон_деҳ():
    бигзор ҳама = []
    барои д аз донишҷӯён:
        илова(ҳама, д["баҳо"])
    саҳифа.нависед(
        саҳифа.матн("Миёнаи синф:", гирд(миёна(ҳама), 2)),
    )

саҳифа.нависед(
    саҳифа.сарлавҳа("Журнали синфи 10"),
    саҳифа.матн("Ҳамагӣ", дарозӣ(донишҷӯён), "донишҷӯ."),
    саҳифа.ҷадвал(тартиб_бо(донишҷӯён, номи), ["ном", "баҳо"]),
    саҳифа.қатор(
        саҳифа.тугма("Беҳтаринро нишон деҳ", беҳтаринро_нишон_деҳ),
        саҳифа.тугма("Миёнаро ҳисоб кун", ҳисобро_нишон_деҳ),
    ),
)
