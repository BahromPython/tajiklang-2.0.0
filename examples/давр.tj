# Даврҳо: барои ва то_вақте

# Ҳарду ҳадд дохил мешаванд: аз 1 то 5 панҷ маротиба кор мекунад
барои i аз 1 то 5:
    навис(i)

навис("---")

# Ҳисоби ҷамъ
бигзор ҷамъ = 0
барои i аз 1 то 10:
    ҷамъ = ҷамъ + i
навис("Ҷамъи 1..10:", ҷамъ)

# Ҳисоб ба поён
барои i аз 3 то 1:
    навис("шумориш:", i)

# Давр бо шарт
бигзор ҳисоб = 1
то_вақте ҳисоб <= 3:
    навис("такрор", ҳисоб)
    ҳисоб = ҳисоб + 1

# Ҷадвали зарб
барои сатр аз 1 то 3:
    барои сутун аз 1 то 3:
        навис(сатр, "x", сутун, "=", сатр * сутун)
