# шакл — расмкашӣ бо матн
#
# Насб: tajik гирифтан шакл
# Истифода: ворид шакл

функсия хат(рамз, дарозии_хат):
    баргардон такрор(рамз, дарозии_хат)

функсия қуттӣ(матни_дарун):
    бигзор паҳноӣ = дарозӣ(матни_дарун) + 2
    навис("┌" + такрор("─", паҳноӣ) + "┐")
    навис("│ " + матни_дарун + " │")
    навис("└" + такрор("─", паҳноӣ) + "┘")

функсия сутун(ном, қимат, ҳадди_беҳтарин):
    агар ҳадди_беҳтарин <= 0:
        баргардон ном
    бигзор дарозии_сутун = бутун(қимат * 30 / ҳадди_беҳтарин)
    баргардон ном + " " + такрор("█", дарозии_сутун) + " " + ба_матн(қимат)

функсия диаграмма(номҳо, қиматҳои_он):
    агар холӣ_аст(қиматҳои_он):
        баргардон холӣ
    бигзор ҳадди_боло = калонтарин(қиматҳои_он)
    барои i аз 0 то дарозӣ(номҳо) - 1:
        навис(сутун(номҳо[i], қиматҳои_он[i], ҳадди_боло))

функсия секунҷа(баландӣ):
    барои i аз 1 то баландӣ:
        навис(такрор("*", i))

функсия ҷадвали_зарб(то_чанд):
    барои сатр аз 1 то то_чанд:
        бигзор хати_ҳозира = ""
        барои сутуни_ҳозира аз 1 то то_чанд:
            хати_ҳозира += ба_матн(сатр * сутуни_ҳозира) + "	"
        навис(хати_ҳозира)
