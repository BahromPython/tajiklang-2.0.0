# расм — сохтани унсурҳои визуалӣ барои TajikWeb
ворид саҳифа

функсия доира(ранг, андоза):
    баргардон саҳифа.қуттӣ("", {"замина": ранг, "васеъӣ": андоза, "баландӣ": андоза, "гӯшаҳо": "50%"})

функсия корт(унвон, матн):
    баргардон саҳифа.қуттӣ(
        саҳифа.сарлавҳа(унвон, 2),
        саҳифа.матн(матн),
        {"замина": "#ffffff", "фосила": 18, "гӯшаҳо": 14, "канор": "1px solid #dbe3ee"},
    )
