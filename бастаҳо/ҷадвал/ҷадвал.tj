# ҷадвал — ҷадвалҳои оддии матнӣ
функсия хат(паҳноӣ):
    баргардон "+" + такрор("-", паҳноӣ) + "+"

функсия нишон(сарлавҳаҳо, сатрҳо):
    навис(хат(40))
    навис("| " + пайваст(сарлавҳаҳо, " | ") + " |")
    навис(хат(40))
    барои сатр аз сатрҳо:
        навис("| " + пайваст(сатр, " | ") + " |")
    навис(хат(40))
