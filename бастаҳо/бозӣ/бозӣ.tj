# бозӣ — асбобҳои хурд барои бозии матнӣ
ворид риёзӣ

функсия хол(дуруст_аст, холҳои_ҳозира):
    агар дуруст_аст:
        баргардон холҳои_ҳозира + 1
    баргардон холҳои_ҳозира

функсия интихоб(номҳо):
    агар холӣ_аст(номҳо):
        баргардон холӣ
    бигзор ҷой = бутун(риёзӣ.тасодуфӣ(0, дарозӣ(номҳо) - 1))
    баргардон номҳо[ҷой]
