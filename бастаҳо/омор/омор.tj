# омор — ҳисобҳои оморӣ
#
# Насб: tajik гирифтан омор
# Истифода: ворид омор

функсия миёнаи_омор(рақамҳо):
    агар холӣ_аст(рақамҳо):
        баргардон 0
    баргардон ҷамъи(рақамҳо) / дарозӣ(рақамҳо)

функсия медиана(рақамҳо):
    агар холӣ_аст(рақамҳо):
        баргардон 0
    бигзор т = тартиб(рақамҳо)
    бигзор н = дарозӣ(т)
    агар н % 2 == 1:
        баргардон т[бутун(н / 2)]
    бигзор чап = т[бутун(н / 2) - 1]
    бигзор рост_ = т[бутун(н / 2)]
    баргардон (чап + рост_) / 2

функсия доман(рақамҳо):
    агар холӣ_аст(рақамҳо):
        баргардон 0
    баргардон калонтарин(рақамҳо) - хурдтарин(рақамҳо)

функсия мода(рақамҳо):
    агар холӣ_аст(рақамҳо):
        баргардон холӣ
    бигзор беҳтарин = рақамҳо[0]
    бигзор шумораи_беҳтарин = 0
    барои қимат аз рақамҳо:
        бигзор ҳозира = шумор(рақамҳо, қимат)
        агар ҳозира > шумораи_беҳтарин:
            шумораи_беҳтарин = ҳозира
            беҳтарин = қимат
    баргардон беҳтарин

функсия дисперсия(рақамҳо):
    агар дарозӣ(рақамҳо) < 2:
        баргардон 0
    бигзор м = миёнаи_омор(рақамҳо)
    бигзор ҷамъи_фарқ = 0
    барои қимат аз рақамҳо:
        бигзор фарқ = қимат - м
        ҷамъи_фарқ += фарқ * фарқ
    баргардон ҷамъи_фарқ / (дарозӣ(рақамҳо) - 1)

функсия инҳироф(рақамҳо):
    баргардон реша(дисперсия(рақамҳо))

функсия хулосаи_омор(рақамҳо):
    баргардон {
        "шумора": дарозӣ(рақамҳо),
        "миёна": миёнаи_омор(рақамҳо),
        "медиана": медиана(рақамҳо),
        "хурдтарин": хурдтарин(рақамҳо),
        "калонтарин": калонтарин(рақамҳо),
        "доман": доман(рақамҳо),
    }
