{
  "name": "tajiklang",
  "displayName": "TajikLang",
  "description": "Забони барномасозӣ бо забони тоҷикӣ — syntax highlighting for .tj files",
  "version": "2.2.2",
  "publisher": "tajiklang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tajiklang",
        "aliases": [
          "TajikLang",
          "tajiklang",
          "Забони тоҷикӣ"
        ],
        "extensions": [
          ".tj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tajiklang",
        "scopeName": "source.tajiklang",
        "path": "./syntaxes/tajiklang.tmLanguage.json"
      }
    ]
  }
}
