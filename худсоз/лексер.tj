# лексер.tj — лексери TajikLang, навишташуда бо худи TajikLang
#
# Ин қадами аввали худсозӣ (bootstrapping): забон бояд тавонад матни худро
# ба токенҳо тақсим кунад, бе ёрии ягон забони дигар.
#
# Ҳар токен як луғат аст:
#     {"навъ": "ном", "қимат": "синну_сол", "сатр": 3}
#
# Навъҳо: рақам, матн, ном, калид, аломат, сатри_нав, дохил, берун, охир

бигзор РАҚАМҲО = "0123456789"
бигзор ФОСИЛА = " " + "\t" + "\r"

# Ҳар чизе, ки ҳарфи ном нест.
бигзор АЛОМАТҲО = "()[]{},.:+-*/%=<>!|#" + "\"" + " " + "\t" + "\r" + "\n"

бигзор КАЛИДҲО = [
    "бигзор", "агар", "вагарна", "барои", "аз", "то", "то_вақте",
    "функсия", "баргардон", "рост", "дурӯғ", "холӣ", "ва", "ё", "не",
    "шикан", "давом", "ворид", "кӯшиш", "хато", "қолиб", "мерос",
]

бигзор ДУГОНА = ["==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "%=", "|>"]

бигзор ФОСИЛАИ_БЛОК = 4


функсия ҳарфи_ном_аст(ҳарф):
    # Ҳарфи тоҷикӣ, лотинӣ, рақам ё зерхат — ҳама номро месозанд.
    баргардон не дорад(АЛОМАТҲО, ҳарф)


функсия рақам_аст_ҳарф(ҳарф):
    баргардон дорад(РАҚАМҲО, ҳарф)


функсия токен(навъ, қимат, сатр):
    баргардон {"навъ": навъ, "қимат": қимат, "сатр": сатр}


функсия хондани_матн(манбаъ, аз_куҷо):
    # Аз нохунаки кушода то нохунаки пӯшида. Натиҷа: [матн, ҷои нав]
    бигзор ҷо = аз_куҷо + 1
    бигзор ҷамъшуда = ""
    бигзор тамом = дурӯғ

    то_вақте ҷо < дарозӣ(манбаъ) ва не тамом:
        бигзор ҳарф = манбаъ[ҷо]
        агар ҳарф == "\"":
            тамом = рост
            ҷо += 1
        вагарна агар ҳарф == "\\":
            агар ҷо + 1 < дарозӣ(манбаъ):
                бигзор оянда = манбаъ[ҷо + 1]
                агар оянда == "n":
                    ҷамъшуда += "\n"
                вагарна агар оянда == "t":
                    ҷамъшуда += "\t"
                вагарна агар оянда == "r":
                    ҷамъшуда += "\r"
                вагарна:
                    # \" ва \\ худашон меоянд.
                    ҷамъшуда += оянда
                ҷо += 2
            вагарна:
                ҷо += 1
        вагарна:
            ҷамъшуда += ҳарф
            ҷо += 1

    баргардон [ҷамъшуда, ҷо]


функсия хондани_рақам(манбаъ, аз_куҷо):
    бигзор ҷо = аз_куҷо
    бигзор ҷамъшуда = ""

    то_вақте ҷо < дарозӣ(манбаъ) ва рақам_аст_ҳарф(манбаъ[ҷо]):
        ҷамъшуда += манбаъ[ҷо]
        ҷо += 1

    агар ҷо + 1 < дарозӣ(манбаъ) ва манбаъ[ҷо] == ".":
        агар рақам_аст_ҳарф(манбаъ[ҷо + 1]):
            ҷамъшуда += "."
            ҷо += 1
            то_вақте ҷо < дарозӣ(манбаъ) ва рақам_аст_ҳарф(манбаъ[ҷо]):
                ҷамъшуда += манбаъ[ҷо]
                ҷо += 1

    баргардон [ҷамъшуда, ҷо]


функсия хондани_ном(манбаъ, аз_куҷо):
    бигзор ҷо = аз_куҷо
    бигзор ҷамъшуда = ""

    то_вақте ҷо < дарозӣ(манбаъ) ва ҳарфи_ном_аст(манбаъ[ҷо]):
        ҷамъшуда += манбаъ[ҷо]
        ҷо += 1

    баргардон [ҷамъшуда, ҷо]


функсия фосилаи_сатр(манбаъ, аз_куҷо):
    # Чанд холигӣ дар аввали сатр. Натиҷа: [шумора, ҷои нав]
    бигзор ҷо = аз_куҷо
    бигзор шумора = 0

    то_вақте ҷо < дарозӣ(манбаъ) ва манбаъ[ҷо] == " ":
        шумора += 1
        ҷо += 1

    баргардон [шумора, ҷо]


функсия сатри_холӣ_аст(манбаъ, ҷо):
    # Оё аз ин ҷо то охири сатр танҳо холигӣ ё шарҳ ҳаст?
    бигзор ҷои_ҳозира = ҷо

    то_вақте ҷои_ҳозира < дарозӣ(манбаъ):
        бигзор ҳарф = манбаъ[ҷои_ҳозира]
        агар ҳарф == "\n":
            баргардон рост
        агар ҳарф == "#":
            баргардон рост
        агар не дорад(ФОСИЛА, ҳарф):
            баргардон дурӯғ
        ҷои_ҳозира += 1

    баргардон рост


функсия токенҳо(манбаъ):
    бигзор натиҷа = []
    бигзор сатҳҳо = [0]
    бигзор ҷо = 0
    бигзор сатр = 1
    бигзор аввали_сатр = рост

    # Чанд қавс кушода аст. То даме ки ҳатто яктояш кушода бошад, сатри нав
    # ва фосила маъно надоранд — ин ба рӯйхати дароз имкон медиҳад, ки ба
    # чанд сатр тақсим шавад.
    бигзор чуқурӣ = 0

    то_вақте ҷо < дарозӣ(манбаъ):
        агар аввали_сатр:
            аввали_сатр = дурӯғ
            бигзор ҷуфт = фосилаи_сатр(манбаъ, ҷо)
            бигзор паҳноӣ = ҷуфт[0]
            бигзор баъд = ҷуфт[1]

            агар сатри_холӣ_аст(манбаъ, баъд):
                ҷо = баъд
            вагарна:
                ҷо = баъд
                бигзор ҳозира = сатҳҳо[-1]
                агар паҳноӣ > ҳозира:
                    илова(сатҳҳо, паҳноӣ)
                    илова(натиҷа, токен("дохил", "", сатр))
                вагарна:
                    то_вақте паҳноӣ < сатҳҳо[-1]:
                        хориҷ(сатҳҳо, -1)
                        илова(натиҷа, токен("берун", "", сатр))
        вагарна:
            бигзор ҳарф = манбаъ[ҷо]

            агар ҳарф == "\n":
                агар чуқурӣ == 0:
                    илова(натиҷа, токен("сатри_нав", "", сатр))
                    аввали_сатр = рост
                сатр += 1
                ҷо += 1
            вагарна агар дорад(ФОСИЛА, ҳарф):
                ҷо += 1
            вагарна агар ҳарф == "#":
                то_вақте ҷо < дарозӣ(манбаъ) ва манбаъ[ҷо] != "\n":
                    ҷо += 1
            вагарна агар ҳарф == "\"":
                бигзор ҷуфти_матн = хондани_матн(манбаъ, ҷо)
                илова(натиҷа, токен("матн", ҷуфти_матн[0], сатр))
                ҷо = ҷуфти_матн[1]
            вагарна агар рақам_аст_ҳарф(ҳарф):
                бигзор ҷуфти_рақам = хондани_рақам(манбаъ, ҷо)
                илова(натиҷа, токен("рақам", ҷуфти_рақам[0], сатр))
                ҷо = ҷуфти_рақам[1]
            вагарна агар ҳарфи_ном_аст(ҳарф):
                бигзор ҷуфти_ном = хондани_ном(манбаъ, ҷо)
                бигзор ном = ҷуфти_ном[0]
                агар дорад(КАЛИДҲО, ном):
                    илова(натиҷа, токен("калид", ном, сатр))
                вагарна:
                    илова(натиҷа, токен("ном", ном, сатр))
                ҷо = ҷуфти_ном[1]
            вагарна:
                бигзор ду = ""
                агар ҷо + 1 < дарозӣ(манбаъ):
                    ду = буриш(манбаъ, ҷо, ҷо + 1)
                агар ду != "" ва дорад(ДУГОНА, ду):
                    илова(натиҷа, токен("аломат", ду, сатр))
                    ҷо += 2
                вагарна:
                    агар дорад("([{", ҳарф):
                        чуқурӣ += 1
                    агар дорад(")]}", ҳарф):
                        агар чуқурӣ > 0:
                            чуқурӣ -= 1
                    илова(натиҷа, токен("аломат", ҳарф, сатр))
                    ҷо += 1

    илова(натиҷа, токен("сатри_нав", "", сатр))
    то_вақте дарозӣ(сатҳҳо) > 1:
        хориҷ(сатҳҳо, -1)
        илова(натиҷа, токен("берун", "", сатр))

    илова(натиҷа, токен("охир", "", сатр))
    баргардон натиҷа
