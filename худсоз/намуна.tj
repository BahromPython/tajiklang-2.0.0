# намуна.tj — барномае, ки ҳамаи қисмҳои муҳимро санҷида мебарояд.

бигзор ном = "Баҳром"
навис("Салом,", ном)

# рақамҳои дақиқ
навис(0.1 + 0.2)
навис(0.1 + 0.2 == 0.3)

# тартиби алифбои тоҷикӣ: ғ баъди г, на баъди я
навис(тартиб(["ям", "ғоз", "гул", "ӯзум", "анор"]))

функсия факториал(н):
    агар н <= 1:
        баргардон 1
    баргардон н * факториал(н - 1)

навис("Факториали 10 =", факториал(10))

бигзор ҷамъ = 0
барои и аз 1 то 100:
    ҷамъ += и
навис("Ҷамъи 1..100 =", ҷамъ)

бигзор рӯйхат = []
барои х аз [3, 1, 4, 1, 5, 9, 2, 6]:
    агар х % 2 == 0:
        илова(рӯйхат, х)
навис("Ҷуфтҳо:", рӯйхат)
навис("Миёна:", миёна([1, 2, 3, 4]))

бигзор ш = 1
то_вақте ш < 5:
    ш = ш * 2
навис("ш =", ш)

бигзор одам = {"ном": "Ситора", "синну_сол": 15}
навис(одам["ном"], одам["синну_сол"])
одам["синну_сол"] = 16
навис("Соли оянда:", одам["синну_сол"])

бигзор рқ = [10, 20, 30]
рқ[1] = 25
навис(рқ, дарозӣ(рқ), ҷамъи(рқ))

агар дарозӣ(ном) > 3 ва не (ном == "Алӣ"):
    навис("Номи дароз")
вагарна агар дарозӣ(ном) == 3:
    навис("Се ҳарф")
вагарна:
    навис("Номи кӯтоҳ")
