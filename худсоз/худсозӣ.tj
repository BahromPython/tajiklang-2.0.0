# худсозӣ.tj — забон тарҷумони худро тарҷума мекунад.
#
# Ин лаҳзаи худсозӣ (bootstrapping) аст. Тарҷумоне, ки бо TajikLang навишта
# шудааст, худи ҳамон файлҳоро мехонад ва ба JavaScript мебарорад. Баъд аз ин
# натиҷа дар Node.js кор мекунад — бе ягон забони дигар дар байн.
#
#     лексер.tj    →  лексер.js
#     тарҷумон.tj  →  тарҷумон.js
#     худсозӣ.tj   →  худсозӣ.js
#
# Баъд `node худсозӣ.js` бояд ҳамон се файлро дубора созад ва натиҷа бояд
# ҳарф ба ҳарф баробар бошад. Ҳамин санҷиш нишон медиҳад, ки тарҷумон дуруст
# аст: агар хатое мебуд, нусхаи дуюм аз нусхаи якум фарқ мекард.

ворид файл
ворид тарҷумон

бигзор ФАЙЛҲО = ["лексер", "тарҷумон", "худсозӣ"]

функсия сохтан(ном):
    бигзор манбаъ = файл.хондан(ном + ".tj")
    бигзор натиҷа = тарҷумон.ба_javascript(манбаъ)
    файл.навиштан(ном + ".js", натиҷа)
    навис(ном + ".tj  →  " + ном + ".js  (" + ба_матн(дарозӣ(натиҷа)) + " ҳарф)")


функсия ҳама_сохтан():
    навис("--- тарҷумаи худи тарҷумон ---")
    барои ном аз ФАЙЛҲО:
        сохтан(ном)
    навис("--- тайёр ---")


ҳама_сохтан()
