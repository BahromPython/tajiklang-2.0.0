# тарҷумон.tj — аз токенҳо ба JavaScript, навишташуда бо худи TajikLang
#
# Ин парсери рекурсивӣ-фуроянда аст, ки бевосита JavaScript менависад.
# Тартиби амалҳо аз шакли қоидаҳо меояд, чун дар парсери асосӣ, ва натиҷа
# ҳамеша дар қавс гузошта мешавад, то тартиб гум нашавад.
#
# Ҳолат дар як луғат нигоҳ дошта мешавад, зеро функсияҳо метавонанд онро
# тағйир диҳанд: {"токенҳо": [...], "ҷо": 0}

ворид лексер

бигзор ЯК_ФОСИЛА = "  "

# Функсияҳои тайёр, ки ба ёрирасони JavaScript тарҷума мешаванд.
бигзор ТАЙЁРҲО = {
    "навис": "__навис",
    "дарозӣ": "__дарозӣ",
    "илова": "__илова",
    "тартиб": "__тартиб",
    "ҷамъи": "__ҷамъи",
    "миёна": "__миёна",
    "калонтарин": "__калонтарин",
    "хурдтарин": "__хурдтарин",
    "баръакс": "__баръакс",
    "ба_матн": "__ба_матн",
    "ба_рақам": "__ба_рақам",
    "калон": "__калон",
    "хурд": "__хурд",
    "такрор": "__такрор",
    "рақамҳо": "__рақамҳо",
    "дорад": "__дорад",
    "буриш": "__буриш",
    "ёфтан": "__ёфтан",
    "тоза": "__тоза",
    "сар_мешавад": "__сар_мешавад",
    "тамом_мешавад": "__тамом_мешавад",
    "ҷудо": "__ҷудо",
    "пайваст": "__пайваст",
    "иваз": "__иваз",
    "ҳарфҳо": "__ҳарфҳо",
    "нусха": "__нусха",
    "калидҳо": "__калидҳо",
    "қиматҳо": "__қиматҳо",
    "шумор": "__шумор",
    "васеъ": "__васеъ",
    "холӣ_аст": "__холӣ_аст",
    "хориҷ": "__хориҷ",
    "дарҷ": "__дарҷ",
    "навъ": "__навъ",
    "мутлақ": "__мутлақ",
    "бутун": "__бутун",
    "гирд": "__гирд",
}


# --- ҳолат ------------------------------------------------------------------

функсия ҳозира(ҳолат):
    баргардон ҳолат["токенҳо"][ҳолат["ҷо"]]


функсия навъи_ҳозира(ҳолат):
    баргардон ҳозира(ҳолат)["навъ"]


функсия қимати_ҳозира(ҳолат):
    баргардон ҳозира(ҳолат)["қимат"]


функсия пеш(ҳолат):
    бигзор т = ҳозира(ҳолат)
    агар ҳолат["ҷо"] < дарозӣ(ҳолат["токенҳо"]) - 1:
        ҳолат["ҷо"] = ҳолат["ҷо"] + 1
    баргардон т


функсия ин_аст(ҳолат, навъ, қимат):
    агар навъи_ҳозира(ҳолат) != навъ:
        баргардон дурӯғ
    агар қимат == холӣ:
        баргардон рост
    баргардон қимати_ҳозира(ҳолат) == қимат


функсия гирифтан(ҳолат, навъ, қимат):
    агар ин_аст(ҳолат, навъ, қимат):
        пеш(ҳолат)
        баргардон рост
    баргардон дурӯғ


функсия талаб(ҳолат, навъ, қимат, паём):
    агар не гирифтан(ҳолат, навъ, қимат):
        бигзор т = ҳозира(ҳолат)
        навис("Хато дар сатри " + ба_матн(т["сатр"]) + ": " + паём)
        навис("   ёфт шуд: " + т["навъ"] + " " + ба_матн(т["қимат"]))
        баргардон дурӯғ
    баргардон рост


функсия сатрҳои_холиро_гузар(ҳолат):
    то_вақте ин_аст(ҳолат, "сатри_нав", холӣ):
        пеш(ҳолат)


# --- ифодаҳо ----------------------------------------------------------------

функсия ифода(ҳолат):
    баргардон ё_ифода(ҳолат)


функсия ё_ифода(ҳолат):
    бигзор чап = ва_ифода(ҳолат)
    то_вақте ин_аст(ҳолат, "калид", "ё"):
        пеш(ҳолат)
        бигзор рост_ = ва_ифода(ҳолат)
        чап = "(" + чап + " || " + рост_ + ")"
    баргардон чап


функсия ва_ифода(ҳолат):
    бигзор чап = не_ифода(ҳолат)
    то_вақте ин_аст(ҳолат, "калид", "ва"):
        пеш(ҳолат)
        бигзор рост_ = не_ифода(ҳолат)
        чап = "(" + чап + " && " + рост_ + ")"
    баргардон чап


функсия не_ифода(ҳолат):
    агар ин_аст(ҳолат, "калид", "не"):
        пеш(ҳолат)
        баргардон "(!" + не_ифода(ҳолат) + ")"
    баргардон муқоиса(ҳолат)


функсия муқоиса(ҳолат):
    бигзор чап = ҷамъ_ифода(ҳолат)
    бигзор аломат = қимати_ҳозира(ҳолат)

    агар ин_аст(ҳолат, "аломат", холӣ):
        агар аломат == "==" ё аломат == "!=":
            пеш(ҳолат)
            бигзор рост_ = ҷамъ_ифода(ҳолат)
            агар аломат == "==":
                баргардон "__баробар(" + чап + ", " + рост_ + ")"
            баргардон "(!__баробар(" + чап + ", " + рост_ + "))"

        агар аломат == "<" ё аломат == ">" ё аломат == "<=" ё аломат == ">=":
            пеш(ҳолат)
            бигзор рост__ = ҷамъ_ифода(ҳолат)
            баргардон "__муқоиса(" + чап + ", " + рост__ + ", \"" + аломат + "\")"

    баргардон чап


функсия ҷамъ_ифода(ҳолат):
    бигзор чап = зарб_ифода(ҳолат)
    то_вақте ин_аст(ҳолат, "аломат", "+") ё ин_аст(ҳолат, "аломат", "-"):
        бигзор аломат = қимати_ҳозира(ҳолат)
        пеш(ҳолат)
        бигзор рост_ = зарб_ифода(ҳолат)
        агар аломат == "+":
            чап = "__ҷамъ(" + чап + ", " + рост_ + ")"
        вагарна:
            чап = "__тарҳ(" + чап + ", " + рост_ + ")"
    баргардон чап


функсия зарб_ифода(ҳолат):
    бигзор чап = яктарафа(ҳолат)
    то_вақте ин_аст(ҳолат, "аломат", "*") ё ин_аст(ҳолат, "аломат", "/") ё ин_аст(ҳолат, "аломат", "%"):
        бигзор аломат = қимати_ҳозира(ҳолат)
        пеш(ҳолат)
        бигзор рост_ = яктарафа(ҳолат)
        агар аломат == "/":
            чап = "__тақсим(" + чап + ", " + рост_ + ")"
        вагарна агар аломат == "%":
            чап = "__бақия(" + чап + ", " + рост_ + ")"
        вагарна:
            чап = "__зарб(" + чап + ", " + рост_ + ")"
    баргардон чап


функсия яктарафа(ҳолат):
    агар ин_аст(ҳолат, "аломат", "-"):
        пеш(ҳолат)
        баргардон "(-" + яктарафа(ҳолат) + ")"
    баргардон пасванд(ҳолат)


функсия пасванд(ҳолат):
    бигзор чап = асосӣ(ҳолат)
    бигзор кор = рост

    то_вақте кор:
        агар ин_аст(ҳолат, "аломат", "("):
            пеш(ҳолат)
            бигзор аргументҳо = []
            агар не ин_аст(ҳолат, "аломат", ")"):
                илова(аргументҳо, ифода(ҳолат))
                то_вақте гирифтан(ҳолат, "аломат", ","):
                    агар не ин_аст(ҳолат, "аломат", ")"):
                        илова(аргументҳо, ифода(ҳолат))
            талаб(ҳолат, "аломат", ")", "қавси пӯшида лозим аст")
            чап = чап + "(" + пайваст(аргументҳо, ", ") + ")"
        вагарна агар ин_аст(ҳолат, "аломат", "["):
            пеш(ҳолат)
            бигзор рақам = ифода(ҳолат)
            талаб(ҳолат, "аломат", "]", "қавси пӯшида лозим аст")
            чап = "__унсур(" + чап + ", " + рақам + ")"
        вагарна агар ин_аст(ҳолат, "аломат", "."):
            пеш(ҳолат)
            бигзор ном = қимати_ҳозира(ҳолат)
            пеш(ҳолат)
            чап = чап + "." + ном
        вагарна:
            кор = дурӯғ

    баргардон чап


функсия асосӣ(ҳолат):
    агар ин_аст(ҳолат, "рақам", холӣ):
        баргардон пеш(ҳолат)["қимат"]

    агар ин_аст(ҳолат, "матн", холӣ):
        баргардон "\"" + матни_ҷавобгӯ(пеш(ҳолат)["қимат"]) + "\""

    агар ин_аст(ҳолат, "калид", "рост"):
        пеш(ҳолат)
        баргардон "true"

    агар ин_аст(ҳолат, "калид", "дурӯғ"):
        пеш(ҳолат)
        баргардон "false"

    агар ин_аст(ҳолат, "калид", "холӣ"):
        пеш(ҳолат)
        баргардон "null"

    агар ин_аст(ҳолат, "аломат", "["):
        пеш(ҳолат)
        бигзор унсурҳо = []
        то_вақте не ин_аст(ҳолат, "аломат", "]") ва не ин_аст(ҳолат, "охир", холӣ):
            илова(унсурҳо, ифода(ҳолат))
            агар не гирифтан(ҳолат, "аломат", ","):
                шикан
        талаб(ҳолат, "аломат", "]", "қавси пӯшида лозим аст")
        баргардон "[" + пайваст(унсурҳо, ", ") + "]"

    агар ин_аст(ҳолат, "аломат", "{"):
        пеш(ҳолат)
        бигзор ҷуфтҳои_луғат = []
        то_вақте не ин_аст(ҳолат, "аломат", "}") ва не ин_аст(ҳолат, "охир", холӣ):
            бигзор калид = ифода(ҳолат)
            талаб(ҳолат, "аломат", ":", "аломати : лозим аст")
            бигзор қимат = ифода(ҳолат)
            илова(ҷуфтҳои_луғат, "[" + калид + "]: " + қимат)
            агар не гирифтан(ҳолат, "аломат", ","):
                шикан
        талаб(ҳолат, "аломат", "}", "қавси пӯшида лозим аст")
        баргардон "{" + пайваст(ҷуфтҳои_луғат, ", ") + "}"

    агар ин_аст(ҳолат, "аломат", "("):
        пеш(ҳолат)
        бигзор дарун = ифода(ҳолат)
        талаб(ҳолат, "аломат", ")", "қавси пӯшида лозим аст")
        баргардон "(" + дарун + ")"

    агар ин_аст(ҳолат, "ном", холӣ):
        бигзор ном = пеш(ҳолат)["қимат"]
        # Номи эълоншуда ҳамеша аз функсияи тайёр болотар аст: дар TajikLang
        # `бигзор навъ = 5` иҷозат дода мешавад ва баъд аз он `навъ` тағйирёбанда
        # аст, на функсия.
        агар дорад(ҳолат["эълоншуда"], ном):
            баргардон номи_ҷавобгӯ(ном)
        агар дорад(ТАЙЁРҲО, ном):
            баргардон ТАЙЁРҲО[ном]
        баргардон номи_ҷавобгӯ(ном)

    бигзор т = ҳозира(ҳолат)
    навис("Хато дар сатри " + ба_матн(т["сатр"]) + ": қимат интизор мешуд")
    пеш(ҳолат)
    баргардон "null"


функсия матни_ҷавобгӯ(матни_хом):
    # Нохунак ва навсатрро барои JavaScript бехатар мекунад.
    бигзор натиҷа = ""
    барои ҳарф аз ҳарфҳо(матни_хом):
        агар ҳарф == "\"":
            натиҷа += "\\\""
        вагарна агар ҳарф == "\\":
            натиҷа += "\\\\"
        вагарна агар ҳарф == "\n":
            натиҷа += "\\n"
        вагарна агар ҳарф == "\r":
            натиҷа += "\\r"
        вагарна агар ҳарф == "\t":
            натиҷа += "\\t"
        вагарна:
            натиҷа += ҳарф
    баргардон натиҷа


функсия номи_ҷавобгӯ(ном):
    # JavaScript номҳои тоҷикиро қабул мекунад, вале зерхати аввал не.
    баргардон "т_" + ном


# --- амалҳо -----------------------------------------------------------------

функсия блок(ҳолат, фосила):
    бигзор сатрҳо = []
    талаб(ҳолат, "сатри_нав", холӣ, "сатри нав лозим аст")
    сатрҳои_холиро_гузар(ҳолат)

    агар не талаб(ҳолат, "дохил", холӣ, "блоки холӣ"):
        баргардон сатрҳо

    то_вақте не ин_аст(ҳолат, "берун", холӣ) ва не ин_аст(ҳолат, "охир", холӣ):
        агар ин_аст(ҳолат, "сатри_нав", холӣ):
            пеш(ҳолат)
        вагарна:
            бигзор натиҷаи_амал = амал(ҳолат, фосила)
            барои сатри_нав аз натиҷаи_амал:
                илова(сатрҳо, сатри_нав)

    гирифтан(ҳолат, "берун", холӣ)
    баргардон сатрҳо


функсия сатҳ(фосила):
    баргардон такрор(ЯК_ФОСИЛА, фосила)


функсия амал(ҳолат, фосила):
    бигзор сатрҳо = []

    # --- ворид ном
    агар ин_аст(ҳолат, "калид", "ворид"):
        пеш(ҳолат)
        бигзор модул = пеш(ҳолат)["қимат"]
        илова(сатрҳо, сатҳ(фосила) + "const " + номи_ҷавобгӯ(модул) +
              " = require(\"./" + модул + ".js\");")
        баргардон сатрҳо

    # --- бигзор ном = ифода
    агар ин_аст(ҳолат, "калид", "бигзор"):
        пеш(ҳолат)
        бигзор ном = номи_ҷавобгӯ(пеш(ҳолат)["қимат"])
        талаб(ҳолат, "аломат", "=", "аломати = лозим аст")
        бигзор қимат = ифода(ҳолат)
        илова(сатрҳо, сатҳ(фосила) + "let " + ном + " = " + қимат + ";")
        баргардон сатрҳо

    # --- агар / вагарна агар / вагарна
    агар ин_аст(ҳолат, "калид", "агар"):
        пеш(ҳолат)
        бигзор шарт = ифода(ҳолат)
        талаб(ҳолат, "аломат", ":", "аломати : лозим аст")
        илова(сатрҳо, сатҳ(фосила) + "if (__шарт(" + шарт + ")) {")
        барои с аз блок(ҳолат, фосила + 1):
            илова(сатрҳо, с)

        сатрҳои_холиро_гузар(ҳолат)
        то_вақте ин_аст(ҳолат, "калид", "вагарна"):
            пеш(ҳолат)
            агар ин_аст(ҳолат, "калид", "агар"):
                пеш(ҳолат)
                бигзор шарти_дигар = ифода(ҳолат)
                талаб(ҳолат, "аломат", ":", "аломати : лозим аст")
                илова(сатрҳо, сатҳ(фосила) + "} else if (__шарт(" + шарти_дигар + ")) {")
                барои с2 аз блок(ҳолат, фосила + 1):
                    илова(сатрҳо, с2)
            вагарна:
                талаб(ҳолат, "аломат", ":", "аломати : лозим аст")
                илова(сатрҳо, сатҳ(фосила) + "} else {")
                барои с3 аз блок(ҳолат, фосила + 1):
                    илова(сатрҳо, с3)
            сатрҳои_холиро_гузар(ҳолат)

        илова(сатрҳо, сатҳ(фосила) + "}")
        баргардон сатрҳо

    # --- барои ном аз ... [то ...]
    агар ин_аст(ҳолат, "калид", "барои"):
        пеш(ҳолат)
        бигзор тағйирёбанда = номи_ҷавобгӯ(пеш(ҳолат)["қимат"])
        талаб(ҳолат, "калид", "аз", "калимаи аз лозим аст")
        бигзор аввал = ифода(ҳолат)

        агар гирифтан(ҳолат, "калид", "то"):
            бигзор охир = ифода(ҳолат)
            талаб(ҳолат, "аломат", ":", "аломати : лозим аст")
            илова(сатрҳо, сатҳ(фосила) + "for (const " + тағйирёбанда +
                  " of __дарак(" + аввал + ", " + охир + ")) {")
        вагарна:
            талаб(ҳолат, "аломат", ":", "аломати : лозим аст")
            илова(сатрҳо, сатҳ(фосила) + "for (const " + тағйирёбанда +
                  " of __рӯйхат(" + аввал + ")) {")

        барои с аз блок(ҳолат, фосила + 1):
            илова(сатрҳо, с)
        илова(сатрҳо, сатҳ(фосила) + "}")
        баргардон сатрҳо

    # --- то_вақте
    агар ин_аст(ҳолат, "калид", "то_вақте"):
        пеш(ҳолат)
        бигзор шарти_давр = ифода(ҳолат)
        талаб(ҳолат, "аломат", ":", "аломати : лозим аст")
        илова(сатрҳо, сатҳ(фосила) + "while (__шарт(" + шарти_давр + ")) {")
        барои с аз блок(ҳолат, фосила + 1):
            илова(сатрҳо, с)
        илова(сатрҳо, сатҳ(фосила) + "}")
        баргардон сатрҳо

    # --- функсия
    агар ин_аст(ҳолат, "калид", "функсия"):
        пеш(ҳолат)
        бигзор номи_функсия = номи_ҷавобгӯ(пеш(ҳолат)["қимат"])
        талаб(ҳолат, "аломат", "(", "қавс лозим аст")
        бигзор параметрҳо = []
        то_вақте не ин_аст(ҳолат, "аломат", ")") ва не ин_аст(ҳолат, "охир", холӣ):
            илова(параметрҳо, номи_ҷавобгӯ(пеш(ҳолат)["қимат"]))
            агар не гирифтан(ҳолат, "аломат", ","):
                шикан
        талаб(ҳолат, "аломат", ")", "қавси пӯшида лозим аст")
        талаб(ҳолат, "аломат", ":", "аломати : лозим аст")
        агар фосила == 0:
            илова(ҳолат["содирот"], номи_функсия)
        илова(сатрҳо, сатҳ(фосила) + "function " + номи_функсия +
              "(" + пайваст(параметрҳо, ", ") + ") {")
        барои с аз блок(ҳолат, фосила + 1):
            илова(сатрҳо, с)
        илова(сатрҳо, сатҳ(фосила) + "}")
        баргардон сатрҳо

    # --- баргардон
    агар ин_аст(ҳолат, "калид", "баргардон"):
        пеш(ҳолат)
        агар ин_аст(ҳолат, "сатри_нав", холӣ):
            илова(сатрҳо, сатҳ(фосила) + "return null;")
        вагарна:
            илова(сатрҳо, сатҳ(фосила) + "return " + ифода(ҳолат) + ";")
        баргардон сатрҳо

    агар ин_аст(ҳолат, "калид", "шикан"):
        пеш(ҳолат)
        илова(сатрҳо, сатҳ(фосила) + "break;")
        баргардон сатрҳо

    агар ин_аст(ҳолат, "калид", "давом"):
        пеш(ҳолат)
        илова(сатрҳо, сатҳ(фосила) + "continue;")
        баргардон сатрҳо

    # --- ифода ё додани қимат
    бигзор чап = ифода(ҳолат)
    бигзор аломати_ҳозира = қимати_ҳозира(ҳолат)

    агар ин_аст(ҳолат, "аломат", "="):
        пеш(ҳолат)
        илова(сатрҳо, сатҳ(фосила) + чапи_ҷавобгӯ(чап) + " = " + ифода(ҳолат) + ";")
        баргардон сатрҳо

    агар ин_аст(ҳолат, "аломат", холӣ) ва дорад(["+=", "-=", "*=", "/=", "%="], аломати_ҳозира):
        пеш(ҳолат)
        бигзор рост_ = ифода(ҳолат)
        бигзор ҳадаф = чапи_ҷавобгӯ(чап)
        бигзор ёрирасон = {
            "+=": "__ҷамъ", "-=": "__тарҳ", "*=": "__зарб",
            "/=": "__тақсим", "%=": "__бақия",
        }
        илова(сатрҳо, сатҳ(фосила) + ҳадаф + " = " + ёрирасон[аломати_ҳозира] +
              "(" + ҳадаф + ", " + рост_ + ");")
        баргардон сатрҳо

    илова(сатрҳо, сатҳ(фосила) + чап + ";")
    баргардон сатрҳо


функсия чапи_ҷавобгӯ(матни_чап):
    # __унсур(x, i) ҳамчун ҳадафи додани қимат бояд x[i] шавад.
    агар сар_мешавад(матни_чап, "__унсур("):
        бигзор дарун = буриш(матни_чап, 8, дарозӣ(матни_чап) - 2)
        бигзор ҷои_вергул = ёфтани_вергули_беруна(дарун)
        агар ҷои_вергул != холӣ:
            бигзор пеши_вергул = буриш(дарун, 0, ҷои_вергул - 1)
            бигзор баъди_вергул = тоза(буриш(дарун, ҷои_вергул + 1, дарозӣ(дарун) - 1))
            баргардон пеши_вергул + "[" + баъди_вергул + "]"
    баргардон матни_чап


функсия ёфтани_вергули_беруна(матн_):
    # Вергуле, ки дар дохили қавс нест.
    бигзор чуқурӣ = 0
    бигзор i = 0
    то_вақте i < дарозӣ(матн_):
        бигзор ҳарф = матн_[i]
        агар ҳарф == "(" ё ҳарф == "[" ё ҳарф == "{":
            чуқурӣ += 1
        вагарна агар ҳарф == ")" ё ҳарф == "]" ё ҳарф == "}":
            чуқурӣ -= 1
        вагарна агар ҳарф == "," ва чуқурӣ == 0:
            баргардон i
        i += 1
    баргардон холӣ


# --- нуқтаи оғоз ------------------------------------------------------------

функсия номҳои_эълоншуда(рӯйхати_токенҳо):
    # Пеш аз тарҷума як бор аз болои токенҳо мегузарем ва ҳар номеро, ки
    # барнома эълон мекунад, ҷамъ меорем: `бигзор ном`, `барои ном`,
    # `ворид ном`, номи функсия ва параметрҳои он.
    бигзор натиҷа = []
    бигзор и = 0

    то_вақте и < дарозӣ(рӯйхати_токенҳо):
        бигзор т = рӯйхати_токенҳо[и]

        агар т["навъ"] == "калид":
            бигзор к = т["қимат"]

            агар к == "бигзор" ё к == "барои" ё к == "ворид":
                агар и + 1 < дарозӣ(рӯйхати_токенҳо):
                    илова(натиҷа, рӯйхати_токенҳо[и + 1]["қимат"])

            агар к == "функсия":
                # Номи функсия ва ҳамаи параметрҳо то қавси пӯшида.
                бигзор ҷ = и + 1
                то_вақте ҷ < дарозӣ(рӯйхати_токенҳо) ва рӯйхати_токенҳо[ҷ]["қимат"] != ")":
                    агар рӯйхати_токенҳо[ҷ]["навъ"] == "ном":
                        илова(натиҷа, рӯйхати_токенҳо[ҷ]["қимат"])
                    ҷ += 1

        и += 1

    баргардон натиҷа


функсия сарлавҳа():
    # Ҳамаи ёрирасонҳо аз асос.js меоянд, то коди тарҷумашуда хонда шавад.
    бигзор номҳо = []
    барои ном аз қиматҳо(ТАЙЁРҲО):
        илова(номҳо, ном)
    барои ном_2 аз ["__ҷамъ", "__тарҳ", "__зарб", "__тақсим", "__бақия",
                    "__шарт", "__баробар", "__муқоиса", "__унсур",
                    "__дарак", "__рӯйхат"]:
        илова(номҳо, ном_2)
    баргардон [
        "// Ин файлро тарҷумони TajikLang сохтааст.",
        "const { " + пайваст(тартиб(номҳо), ", ") + " } = require(\"./асос.js\");",
        "",
    ]


функсия ба_javascript(манбаъ):
    бигзор ҳамаи_токенҳо = лексер.токенҳо(манбаъ)
    бигзор ҳолат = {
        "токенҳо": ҳамаи_токенҳо,
        "ҷо": 0,
        "содирот": [],
        "эълоншуда": номҳои_эълоншуда(ҳамаи_токенҳо),
    }
    бигзор сатрҳо = сарлавҳа()

    то_вақте не ин_аст(ҳолат, "охир", холӣ):
        агар ин_аст(ҳолат, "сатри_нав", холӣ) ё ин_аст(ҳолат, "дохил", холӣ) ё ин_аст(ҳолат, "берун", холӣ):
            пеш(ҳолат)
        вагарна:
            барои с аз амал(ҳолат, 0):
                илова(сатрҳо, с)

    # Ҳар функсияи болоӣ содир мешавад, то файлҳои дигар онро ворид кунанд.
    агар дарозӣ(ҳолат["содирот"]) > 0:
        бигзор ҷуфтҳои_содирот = []
        барои номи_дарунӣ аз ҳолат["содирот"]:
            бигзор номи_беруна = буриш(номи_дарунӣ, 2, дарозӣ(номи_дарунӣ) - 1)
            илова(ҷуфтҳои_содирот, номи_беруна + ": " + номи_дарунӣ)
        илова(сатрҳо, "")
        илова(сатрҳо, "module.exports = { " + пайваст(ҷуфтҳои_содирот, ", ") + " };")

    баргардон пайваст(сатрҳо, "\n") + "\n"
