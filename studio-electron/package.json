{
  "name": "tajiklang-studio",
  "version": "0.1.0",
  "private": true,
  "description": "TajikLang Studio — Electron workbench",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.tajiklang.studio",
    "productName": "TajikLang Studio",
    "directories": { "output": "release" },
    "files": ["**/*", "!release"],
    "extraResources": [{ "from": "../dist/TajikLang", "to": "runtime", "filter": ["**/*"] }],
    "win": { "target": "nsis", "icon": "../build/tajiklang-studio.ico" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
