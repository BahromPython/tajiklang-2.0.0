{
  "name": "tajiklang-studio",
  "version": "3.0.4",
  "private": true,
  "description": "TajikLang Studio — Electron workbench",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.tajiklang.studio",
    "productName": "TajikLang Studio",
    "directories": { "output": "release" },
    "files": ["**/*", "!release"],
    "extraResources": [{ "from": "../dist/TajikLang", "to": "runtime", "filter": ["**/*"] }],
    "fileAssociations": [{ "ext": "tj", "name": "TajikLang Program", "description": "Барномаи TajikLang", "role": "Editor" }],
    "win": { "target": "nsis", "icon": "assets/tajiklang.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "include": "installer.nsh" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
