{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TajikLang: иҷрои файл",
      "type": "shell",
      "command": "py",
      "args": [
        "-m",
        "tajiklang",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "TajikLang: токенҳо",
      "type": "shell",
      "command": "py",
      "args": [
        "-m",
        "tajiklang",
        "--tokens",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "TajikLang: дарахти синтаксисӣ",
      "type": "shell",
      "command": "py",
      "args": [
        "-m",
        "tajiklang",
        "--ast",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "TajikLang: реҷаи интерактивӣ",
      "type": "shell",
      "command": "py",
      "args": [
        "-m",
        "tajiklang"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "TajikLang: санҷишҳо",
      "type": "shell",
      "command": "py",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-t",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "TajikLang: майдончаро аз нав созед",
      "type": "shell",
      "command": "py",
      "args": [
        "tools/build_playground.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
