{
  "files.encoding": "utf8",
  "files.associations": {
    "*.tj": "tajiklang"
  },
  "[tajiklang]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.trimAutoWhitespace": true,
    "editor.rulers": [
      79
    ],
    "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
